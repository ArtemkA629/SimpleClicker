    - languageId: Russian
      value: "\u041E\u0442\u043A\u0440\u043E\u0439\u0442\u0435 \u043D\u043E\u0432\u044B\u0435
        \u043B\u043E\u043A\u0430\u0446\u0438\u0438"
  - id: rebirth_description
    languages:
    - languageId: English
      value: Rebirth to get permanent bonuses
    - languageId: Russian
      value: "\u041F\u0435\u0440\u0435\u0440\u043E\u0434\u0438\u0442\u0435\u0441\u044C,
        \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C
        \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u044B\u0435 \u0431\u043E\u043D\u0443\u0441\u044B"
  - id: first_click_tutorial_description
    languages:
    - languageId: English
      value: Click on the cookie to start playing.
    - languageId: Russian
      value: "\u041A\u043B\u0438\u043A\u043D\u0438 \u043F\u043E \u043F\u0435\u0447\u0435\u043D\u044C\u043A\u0435,
        \u0447\u0442\u043E\u0431\u044B \u043D\u0430\u0447\u0430\u0442\u044C \u0438\u0433\u0440\u0430\u0442\u044C."
  - id: temporary_boost_tutorial_description
    languages:
    - languageId: English
      value: Click on the gold cookie to temporarily double your earnings per click.
    - languageId: Russian
      value: "\u041A\u043B\u0438\u043A\u043D\u0438 \u043D\u0430 \u0437\u043E\u043B\u043E\u0442\u0443\u044E
        \u043F\u0435\u0447\u0435\u043D\u044C\u043A\u0443, \u0447\u0442\u043E\u0431\u044B
        \u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E \u0443\u0434\u0432\u043E\u0438\u0442\u044C
        \u0434\u043E\u0445\u043E\u0434 \u0437\u0430 \u043A\u043B\u0438\u043A."
